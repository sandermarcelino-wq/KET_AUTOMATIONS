# Exclusivamente simulado. DRY_RUN=false ou NODE_ENV=production devem bloquear a API.
DRY_RUN=true
PORT=3001
HOST=127.0.0.1
# PostgreSQL embarcado (PGlite), persistente em disco; não é Supabase remoto.
DATA_DIR=./data/construtora
# Sessões de desenvolvimento; nunca disponibilizar esta autenticação na internet.
DEV_AUTH_ENABLED=true
# Etapa 1: nº mínimo de propostas comparáveis para dispensar o aviso de "comparação limitada" (1 a 10).
MIN_COMPARABLE_QUOTES=2

# --- Etapas 2–4 (todas opcionais; sem elas tudo permanece simulado) ---
JOBS_INTERVAL_MINUTES=30
# WhatsApp Cloud API (Meta). Segredos SOMENTE por ambiente; nunca no repositório.
# WHATSAPP_LIVE=true            # envio real: exige autenticação real (Etapa 5)
# META_APP_SECRET=              # valida a assinatura X-Hub-Signature-256 do webhook
# META_VERIFY_TOKEN=            # desafio de verificação do webhook
# META_ACCESS_TOKEN=            # token do usuário do sistema (envio e download de mídia)
# META_API_VERSION=v21.0
# WHATSAPP_GENERIC_TEMPLATE=nome_do_template:pt_BR   # template aprovado para mensagens fora da janela de 24 h
# APPROVAL_CODE_SECRET=         # segredo do código de aprovação por WhatsApp (gere um valor aleatório longo)
# PLATFORM_ADMIN_TOKEN=         # opcional: exige este token para cadastrar números de WhatsApp (SaaS)
# IA (opcional): a IA só sugere; regras e permissões decidem
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# STT_API_URL=                  # endpoint compatível com /audio/transcriptions
# STT_API_KEY=
# E-mail ao contador (SMTP)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# DEBUG_API=true                # registra stack de erros internos (somente desenvolvimento)
